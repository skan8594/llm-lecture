rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEMO ONLY: all session paths below are publicly readable and writable.
    // Do not use for real student identities or company data without authentication.
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Onboarding sessions (e.g., 2026onboarding) and live collections
    match /sessions/{sessionId} {
      allow read, write: if true;

      match /submissions/{submissionId} {
        allow read, write: if true;
      }

      match /teams/{teamId} {
        allow read, write: if true;
      }

      match /votes/{voteId} {
        allow read, write: if true;
      }
    }
  }
}
